<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/apple_background"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="40dp">

        <!-- ═══  BRAND & LARGE TITLE HEADER (Apple HIG Navigation Style) ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DOĞRU TİCARET"
                android:textSize="11sp"
                android:textColor="@color/apple_label_secondary"
                android:textStyle="bold"
                android:letterSpacing="0.14"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kurumsal Çağrı"
                android:textSize="30sp"
                android:textColor="@color/apple_label_primary"
                android:textStyle="bold"
                android:letterSpacing="-0.02"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Santral Entegrasyonu ve Arka Plan Takip Servisi"
                android:textSize="13sp"
                android:textColor="@color/apple_label_secondary"
                android:lineSpacingMultiplier="1.2" />
        </LinearLayout>

        <!-- ═══ 🔴 DİKKAT: CİHAZ PASİFE ALINDI UYARI KARTI ═══ -->
        <LinearLayout
            android:id="@+id/cardPassiveAlert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:backgroundTint="@color/apple_red_tint"
            android:padding="18dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CİHAZ CRM'DEN PASİFE ALINDI"
                android:textSize="14sp"
                android:textColor="@color/apple_red"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bu cihaz yönetim panelinden pasif duruma getirilmiştir. Aramalar sunucuya işlenmeyecektir. Lütfen şirket yöneticiniz ile iletişime geçin."
                android:textSize="12.5sp"
                android:textColor="#FCA5A5"
                android:lineSpacingMultiplier="1.25" />
        </LinearLayout>

        <!-- ═══ 🔒  E-KATALOG YÖNETİCİ KİLİDİ UYARI KARTI ═══ -->
        <LinearLayout
            android:id="@+id/cardUiLocked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:backgroundTint="@color/apple_blue_tint"
            android:padding="18dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="YÖNETİCİ KİLİDİ AKTİF"
                    android:textSize="13sp"
                    android:textColor="@color/apple_blue"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="E-Katalog Korumalı"
                    android:textSize="10sp"
                    android:textColor="@color/apple_label_secondary"
                    android:background="@drawable/pill_chip"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bu cihazın kurulumu onaylanmış ve yönetim panelinden kilitlenmiştir. Personel müdahalesini engellemek için butonlar devre dışıdır. Kilit yalnızca yönetim panelinden açılabilir."
                android:textSize="12.5sp"
                android:textColor="#CBD5E1"
                android:lineSpacingMultiplier="1.25" />
        </LinearLayout>

        <!-- ═══  HERO SERVICE STATUS CARD (Apple Grouped Inset Card) ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SERVİS ÇALIŞMA DURUMU"
                android:textSize="11sp"
                android:textColor="@color/apple_label_secondary"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DURDURULDU"
                android:textSize="20sp"
                android:textColor="@color/apple_red"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnToggle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="▶ Servisi Başlat"
                android:textSize="15sp"
                android:textColor="@color/apple_label_primary"
                android:textStyle="bold"
                android:backgroundTint="@color/apple_blue"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- ═══  TELEMETRY & LIVE METRICS CARD (Apple Health Inset Style) ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CANLI VERİLER VE İSTATİSTİKLER"
                android:textSize="11sp"
                android:textColor="@color/apple_label_secondary"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="14dp" />

            <!-- Row 1: Toplam Çağrı & Kuyruk -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/pill_chip"
                    android:padding="12dp"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TOPLAM ÇAĞRI"
                        android:textSize="10sp"
                        android:textColor="@color/apple_label_secondary"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/txtCallCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 çağrı"
                        android:textSize="15sp"
                        android:textColor="@color/apple_label_primary"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/pill_chip"
                    android:padding="12dp"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SENKRONİZASYON"
                        android:textSize="10sp"
                        android:textColor="@color/apple_label_secondary"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/txtQueueStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kuyruk boş"
                        android:textSize="13sp"
                        android:textColor="@color/apple_green"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row 2: Son Arama -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/pill_chip"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SON ALGILANAN ARAMA"
                    android:textSize="10sp"
                    android:textColor="@color/apple_label_secondary"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/txtLastCall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Henüz çağrı algılanmadı"
                    android:textSize="13sp"
                    android:textColor="@color/apple_label_primary" />
            </LinearLayout>

            <!-- Row 3: Pil Durumu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/pill_chip"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PİL OPTİMİZASYON DURUMU"
                    android:textSize="10sp"
                    android:textColor="@color/apple_label_secondary"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/txtBatteryStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kontrol ediliyor..."
                    android:textSize="13sp"
                    android:textColor="@color/apple_orange" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══  QUICK QR SETUP CARD (Apple Camera Card) ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HIZLI KURULUM"
                android:textSize="11sp"
                android:textColor="@color/apple_label_secondary"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kamerayla QR Kod Eşleme"
                android:textSize="17sp"
                android:textColor="@color/apple_label_primary"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Yönetim panelindeki cihaz QR kodunu kamerayla okutarak sunucu adresini ve cihaz anahtarını anında otomatik yapılandırın."
                android:textSize="12.5sp"
                android:textColor="@color/apple_label_secondary"
                android:lineSpacingMultiplier="1.25"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnScanQr"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="📷 QR Kodu Tara &amp; Eşleştir"
                android:textSize="14sp"
                android:textColor="@color/apple_label_primary"
                android:textStyle="bold"
                android:backgroundTint="@color/apple_blue"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- ═══  SYSTEM SECURITY & PERMISSIONS CARD ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GÜVENLİK VE SİSTEM İZİNLERİ"
                android:textSize="11sp"
                android:textColor="@color/apple_label_secondary"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="12dp" />

            <!-- Silinmeye Karşı Cihaz Yöneticisi -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Silinmeye Karşı Koruma"
                android:textSize="15sp"
                android:textColor="@color/apple_label_primary"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/txtAdminStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Koruma durumu denetleniyor..."
                android:textSize="13sp"
                android:textColor="@color/apple_orange"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cihaz Yöneticisi aktif edildiğinde kullanıcıların ve personellerin uygulamayı telefondan silmesi engellenir."
                android:textSize="12sp"
                android:textColor="@color/apple_label_tertiary"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnAdmin"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="🛡️ Silinme Korumasını Etkinleştir"
                android:textSize="13sp"
                android:textColor="@color/apple_label_primary"
                android:textStyle="bold"
                android:backgroundTint="@color/apple_tertiary_background"
                android:stateListAnimator="@null"
                android:layout_marginBottom="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/apple_separator"
                android:layout_marginBottom="16dp" />

            <!-- Pil Kısıtlaması -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Arka Plan Pil Optimizasyonu"
                android:textSize="15sp"
                android:textColor="@color/apple_label_primary"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Android'in pil tasarrufu modu çağrı dinleme servisini durdurmaması için pil optimizasyonu istisnası tanımlanmalıdır."
                android:textSize="12sp"
                android:textColor="@color/apple_label_tertiary"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnBattery"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="⚡ Pil Kısıtlamasını Kaldır"
                android:textSize="13sp"
                android:textColor="@color/apple_orange"
                android:textStyle="bold"
                android:backgroundTint="@color/apple_tertiary_background"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- ═══  ADVANCED SERVER SETTINGS CARD (iOS Grouped Fields) ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GELİŞMİŞ BAĞLANTI AYARLARI"
                android:textSize="11sp"
                android:textColor="@color/apple_label_secondary"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="12dp" />

            <!-- API URL Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="API Sunucu Adresi"
                android:textSize="13sp"
                android:textColor="@color/apple_label_secondary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/txtApiUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="https://bayi.mehmetdogrultd.com"
                android:textSize="13sp"
                android:textColor="@color/apple_blue"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/editApiUrl"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:hint="https://bayi.mehmetdogrultd.com"
                android:textSize="13sp"
                android:textColor="@color/apple_label_primary"
                android:textColorHint="@color/apple_label_tertiary"
                android:background="@drawable/edit_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:inputType="textUri"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btnSaveUrl"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="URL Kaydet"
                    android:textSize="13sp"
                    android:textColor="@color/apple_label_primary"
                    android:backgroundTint="@color/apple_tertiary_background"
                    android:stateListAnimator="@null"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnTestApi"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Bağlantı Testi"
                    android:textSize="13sp"
                    android:textColor="@color/apple_blue"
                    android:backgroundTint="@color/apple_blue_tint"
                    android:stateListAnimator="@null"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtTestResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="@color/apple_label_secondary"
                android:background="@drawable/pill_chip"
                android:padding="10dp"
                android:layout_marginBottom="14dp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/apple_separator"
                android:layout_marginBottom="16dp" />

            <!-- Device Token Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cihaz Güvenlik Anahtarı"
                android:textSize="13sp"
                android:textColor="@color/apple_label_secondary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/txtDeviceTokenStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Anahtar kontrol ediliyor..."
                android:textSize="13sp"
                android:textColor="@color/apple_red"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/editDeviceToken"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:hint="MD-XXXX-XXXX-XXXX"
                android:textSize="13sp"
                android:textColor="@color/apple_label_primary"
                android:textColorHint="@color/apple_label_tertiary"
                android:background="@drawable/edit_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:inputType="textPassword"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSaveDeviceToken"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Anahtarı Kaydet"
                    android:textSize="13sp"
                    android:textColor="@color/apple_label_primary"
                    android:backgroundTint="@color/apple_tertiary_background"
                    android:stateListAnimator="@null"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnVerifyDeviceToken"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Doğrula"
                    android:textSize="13sp"
                    android:textColor="@color/apple_blue"
                    android:backgroundTint="@color/apple_blue_tint"
                    android:stateListAnimator="@null"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══  SOFTWARE UPDATE CARD ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="20dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="YAZILIM GÜNCELLEMESİ"
                android:textSize="11sp"
                android:textColor="@color/apple_label_secondary"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/txtAppVersionInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sürüm: v2.0.3"
                android:textSize="15sp"
                android:textColor="@color/apple_label_primary"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/txtUpdateStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Otomatik arka plan güncellemeleri etkin."
                android:textSize="12sp"
                android:textColor="@color/apple_label_secondary"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btnCheckUpdate"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="🔄 Güncellemeleri Denetle"
                android:textSize="13sp"
                android:textColor="@color/apple_label_primary"
                android:textStyle="bold"
                android:backgroundTint="@color/apple_tertiary_background"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <!-- ═══  FOOTER ═══ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Servis başlatıldıktan sonra uygulama kapatılabilir. Telefon yeniden başlatılsa bile santral dinleme ve arama aktarımı otomatik olarak arka planda devam eder."
            android:textSize="11.5sp"
            android:textColor="@color/apple_label_tertiary"
            android:lineSpacingMultiplier="1.3"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/txtFooterVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Doğru CRM Çağrı Takip v2.0.3"
            android:textSize="11sp"
            android:textColor="@color/apple_label_quaternary"
            android:gravity="center" />
    </LinearLayout>
</ScrollView>
